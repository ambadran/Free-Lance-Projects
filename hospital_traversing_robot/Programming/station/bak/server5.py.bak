"""
Server hosted by micropython device to control Robot - Revised
"""
import network
import socket
import json
import time

class HTML_REQUEST:
    GET_WEB = 0
    POST_EXECUTE_COMMAND = 1
    GET_RESPONSE = 2

class Server:
    # Access Point Parameters
    SSID = "Hospital Rover Controller"
    PASSWORD = "12345678"
    DEFAULT_WEB_NAME = 'index.html'
    MAX_REQUEST_SIZE = 4096  # Increased buffer size
    CONNECTION_TIMEOUT = 5  # seconds
    
    def __init__(self):
        self.reset()
        self.init_access_point()
        self.init_socket()
        self.cmd_response_dict = {}
        self.exec_cmd_dict = {}
        self.request_count = 0

        self.IDENTIFY_HTML_REQUEST = {
            '/': HTML_REQUEST.GET_WEB,
            '/execute_command': HTML_REQUEST.POST_EXECUTE_COMMAND,
            '/get_response': HTML_REQUEST.GET_RESPONSE
        }

    def reset(self):
        self.station = network.WLAN(network.AP_IF)
        self.station.active(False)
        time.sleep(2)
        self.station.active(True)

    def init_access_point(self):
        self.station.config(ssid=self.SSID, password=self.PASSWORD)
        while not self.station.active():
            print("Access Point Initializing.. ", end=' \r')
            time.sleep(0.5)
        print('Access Point Active!')
        print(self.station.ifconfig())

    def init_socket(self):
        try:
            self.addr = socket.getaddrinfo('0.0.0.0', 80)[0][-1]
            self.s = socket.socket()
            self.s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            self.s.bind(self.addr)
            self.s.listen(1)
            print('Listening on', self.addr)
        except OSError as e:
            print(f"Socket init error: {e}")
            self.s.close()
            time.sleep(1)
            self.init_socket()

    def wait_for_client(self):
        try:
            self.client, addr = self.s.accept()
            print(f"Connection from {addr}")
            self.client.settimeout(self.CONNECTION_TIMEOUT)
        except OSError as e:
            print(f"Client accept error: {e}")

    def process_request(self):
        """Process a single HTTP request"""
        try:
            # Read request
            request = self.client.recv(self.MAX_REQUEST_SIZE).decode()
            if not request:
                return False
                
            # Parse request line
            lines = request.split('\r\n')
            request_line = lines[0].split(' ')
            if len(request_line) < 2:
                return False
                
            method = request_line[0]
            path = request_line[1].split('?')[0]  # Ignore query params
            
            # Identify request type
            request_type = self.IDENTIFY_HTML_REQUEST.get(path, None)
            
            if request_type == HTML_REQUEST.GET_WEB:
                self.handle_get_web(path)
            elif request_type == HTML_REQUEST.POST_EXECUTE_COMMAND and method == "POST":
                self.handle_post_exec_command(request)
            elif request_type == HTML_REQUEST.GET_RESPONSE and method == "GET":
                self.handle_get_command_response(request)
            else:
                self.handle_unknown_request()
                
            return True
        except Exception as e:
            print(f"Request processing error: {e}")
            return False

    def handle_connection(self):
        """Handle multiple requests on a single connection"""
        try:
            # Process requests until client disconnects or times out
            while self.process_request():
                # Reset timeout for subsequent requests
                self.client.settimeout(self.CONNECTION_TIMEOUT)
                
            print("Client disconnected")
        except Exception as e:
            print(f"Connection error: {e}")
        finally:
            try:
                self.client.close()
            except:
                pass

    def send_response(self, code, content, content_type="text/html", keep_alive=True):
        """Send HTTP response"""
        try:
            response = f"HTTP/1.1 {code} {'OK' if code == 200 else 'Error'}\r\n"
            response += f"Content-Type: {content_type}\r\n"
            response += "Access-Control-Allow-Origin: *\r\n"  # For CORS
            
            if keep_alive:
                response += "Connection: keep-alive\r\n"
                response += f"Keep-Alive: timeout={self.CONNECTION_TIMEOUT}\r\n"
            else:
                response += "Connection: close\r\n"
                
            response += f"Content-Length: {len(content)}\r\n\r\n"
            response += content
            self.client.send(response.encode())
            return True
        except Exception as e:
            print(f"Response sending error: {e}")
            return False

    def handle_get_web(self, path):
        try:
            if path == '/':
                path = self.DEFAULT_WEB_NAME
            else:
                path = path[1:]  # Remove leading slash
            
            # Security: Only serve known files
            if path not in [self.DEFAULT_WEB_NAME, "style.css", "script.js"]:
                self.send_response(404, "File Not Found")
                return
            
            # Try to open and send file
            with open(path, 'r') as f:
                content = f.read()
            
            content_type = "text/html"
            if path.endswith(".css"):
                content_type = "text/css"
            elif path.endswith(".js"):
                content_type = "application/javascript"
                
            self.send_response(200, content, content_type)
        except Exception as e:
            print(f"Web serving error: {e}")
            self.send_response(500, "Internal Server Error")

    def handle_get_command_response(self, request):
        try:
            # Parse query parameters
            path = request.split(' ', 2)[1]
            params = {}
            if '?' in path:
                query_str = path.split('?', 1)[1]
                for pair in query_str.split('&'):
                    if '=' in pair:
                        key, value = pair.split('=', 1)
                        params[key] = value
                        
            target = params.get('target')
            method = params.get('method')
            
            if not target or not method:
                self.send_response(400, "Missing target or method")
                return
                
            # Look up response in dictionary
            key = (target, method)
            response = self.cmd_response_dict.get(key, None)
            
            if response is None:
                self.send_response(404, f"Response not found for {target}.{method}")
                return
                
            # Send JSON response
            self.send_response(200, json.dumps({"response": response}), "application/json")
        except Exception as e:
            print(f"Response retrieval error: {e}")
            self.send_response(500, "Internal Server Error")

    def handle_post_exec_command(self, request):
        try:
            # Extract JSON body
            body = ""
            if '\r\n\r\n' in request:
                body = request.split('\r\n\r\n', 1)[1]
            
            if not body:
                self.send_response(400, "Empty request body")
                return
                
            try:
                data = json.loads(body)
            except ValueError as e:
                self.send_response(400, f"Invalid JSON: {str(e)}")
                return
            
            # Validate required fields
            if 'target' not in data or 'method' not in data:
                self.send_response(400, "Missing target or method")
                return
                
            # Extract parameters
            target = data['target']
            method = data['method']
            params = data.get('params', {})
            
            # Store in execution dictionary
            key = (target, method)
            self.exec_cmd_dict[key] = params
            
            # Acknowledge receipt
            self.send_response(200, "Command received")
        except Exception as e:
            print(f"Command execution error: {e}")
            self.send_response(500, "Internal Server Error")

    def handle_unknown_request(self):
        self.send_response(404, "404 Not Found")
